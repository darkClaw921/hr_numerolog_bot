BOT_TOKEN=your_telegram_bot_token_here

# Строка подключения к БД (SQLite по умолчанию).
# Оба бота — нумеролог и будущий бот совместимости — должны указывать на ОДИН файл.
DATABASE_URL=sqlite+aiosqlite:///./numerology.db

# Telegram ID администраторов (через запятую) — могут выдавать премиум командой /grant.
ADMIN_USER_IDS=

# Telegram ID, которым премиум выдаётся без оплаты (через запятую), fallback к БД.
PREMIUM_USER_IDS=

# Стоимость подписки в рублях — должна совпадать с `cost` подписки в Prodamus.
SUBSCRIPTION_PRICE_RUB=299

# Цена первого платежа, если в подписке Prodamus задана скидка на первый платёж
# (по умолчанию равна SUBSCRIPTION_PRICE_RUB — без скидки).
SUBSCRIPTION_FIRST_PAYMENT_RUB=

# --- Платежи Prodamus ---------------------------------------------------------
# Включает приём оплат и HTTP-сервер вебхука. Без заполненных полей ниже не включать.
PAYMENTS_ENABLED=false

# Адрес платёжной формы и секретный ключ из ЛК Prodamus (ключ хранить ТОЛЬКО в .env).
PRODAMUS_FORM_URL=https://biohimrefresh.payform.ru
PRODAMUS_SECRET_KEY=

# ID клубной подписки, созданной в ЛК Prodamus.
PRODAMUS_SUBSCRIPTION_ID=

# Пробный период в днях (0 — первое списание сразу).
PRODAMUS_TRIAL_DAYS=0

# Тестовый режим оплаты (деньги не списываются).
PRODAMUS_DEMO_MODE=false

# Запас в днях после даты следующего списания, чтобы доступ не пропал между попытками.
PRODAMUS_GRACE_DAYS=2

# Публичный HTTPS-адрес перед reverse proxy и путь вебхука.
PUBLIC_BASE_URL=
PRODAMUS_WEBHOOK_PATH=/prodamus/webhook
PRODAMUS_WEBHOOK_HOST=0.0.0.0
PRODAMUS_WEBHOOK_PORT=8080

# Период подписки, если Prodamus не прислал дату следующего списания.
SUBSCRIPTION_PERIOD_DAYS=31

# Реферальная программа: +N дней премиума пригласившему за каждого оплатившего друга.
REFERRAL_BONUS_DAYS=10

# Username бота без @ — куда возвращать пользователя после оплаты.
BOT_USERNAME=
