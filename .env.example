BOT_TOKEN=your_telegram_bot_token_here

# Строка подключения к БД (SQLite по умолчанию).
# Оба бота — нумеролог и будущий бот совместимости — должны указывать на ОДИН файл.
DATABASE_URL=sqlite+aiosqlite:///./numerology.db

# Telegram ID администраторов (через запятую) — могут выдавать премиум командой /grant.
ADMIN_USER_IDS=

# Telegram ID, которым премиум выдаётся без оплаты (через запятую), fallback к БД.
PREMIUM_USER_IDS=

# Стоимость подписки в рублях (для текста-оффера).
SUBSCRIPTION_PRICE_RUB=299
